{% extends 'base.html.twig' %}
{% block title %}Partie {{ game.name }}{% endblock %}

{% block main %}
    <main class="p-12 flex flex-col bg-emerald-100 gap-8">
        <h1 class="text-3xl self-center text-center">Partie {{ game.name }}</h1>

        {% if game.archived %}
            <p class="bg-gray-300 p-4" role="status">
                Partie archivée le {{ game.archivedAt|date('d/m/Y') }} : elle est fermée aux nouveaux joueurs,
                ses fiches restent jouables.
            </p>
        {% else %}
            {{ include('game/_invitation.html.twig') }}
        {% endif %}

        {{ include('game/_players.html.twig') }}

        <twig:Molecule:CharacterBlock
            game="{{ game }}"
        />

        <twig:Molecule:NonPlayableCharacterBlock
            game="{{ game }}"
        />

        <twig:Molecule:MonsterBlock
            game="{{ game }}"
        />

        <twig:Molecule:ArmamentBlock
            game="{{ game }}"
        />

        {# Archiving replaces deletion: nothing is deleted (see docs/game.md). #}
        <form
            method="POST"
            data-turbo="false"
            action="{{ path(game.archived ? 'unarchive_game' : 'archive_game', {id: game.id}) }}"
            {% if not game.archived %}onsubmit="return confirm('Archiver la partie ? Elle sera masquée et fermée aux nouveaux joueurs. Rien n\'est supprimé, les fiches restent jouables.')"{% endif %}
        >
            <input type="hidden" name="_token" value="{{ csrf_token('game-archive-' ~ game.id) }}">
            <twig:Button type="submit" variant="{{ game.archived ? 'success' : 'danger' }}">
                {{ game.archived ? 'Désarchiver la partie' : 'Archiver la partie' }}
            </twig:Button>
        </form>

        <twig:Button
                href="{{ path('show_encyclopedia') }}"
                class="w-52 justify-self-right"
        >
            Go to the Encyclopedia
        </twig:Button>


        <p>Notes: {{ game.note }}</p>
    </main>
{% endblock %}